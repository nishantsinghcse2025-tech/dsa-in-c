#include <stdio.h>

int main() {
    int a[3] = {10, 20, 30};
    int b[3] = {40, 50, 60};
    int c[6];

    int i, j;

    for (i = 0; i < 3; i++) {
        c[i] = a[i];
    }


    for (j = 0; j < 3; j++) {
        c[i + j] = b[j];
    }

    printf("Merged Array: ");
    for (i = 0; i < 6; i++) {
        printf("%d ", c[i]);
    }

    return 0;
}
